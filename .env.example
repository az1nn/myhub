# MyHub business runtime
MYHUB_ENVIRONMENT=development
MYHUB_DATABASE_URL=postgresql+psycopg://myhub:change-me@postgres:5432/myhub

# Required. Generate with: python scripts/generate-bootstrap-token.py
MYHUB_BOOTSTRAP_TOKEN=

# Authentication lifetimes
MYHUB_AUTH_CHALLENGE_TTL_SECONDS=300
MYHUB_AUTH_SESSION_TTL_SECONDS=2592000

# Argon2id minimums follow the current OWASP baseline.
MYHUB_PASSWORD_ARGON2_MEMORY_KIB=19456
MYHUB_PASSWORD_ARGON2_TIME_COST=2
MYHUB_PASSWORD_ARGON2_PARALLELISM=1

# Required for Android Credential Manager / passkey domain association in production.
# Multiple SHA-256 fingerprints may be comma-separated.
MYHUB_ANDROID_PACKAGE_NAME=
MYHUB_ANDROID_SHA256_CERT_FINGERPRINTS=
